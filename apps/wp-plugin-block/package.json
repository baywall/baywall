{
  "name": "@baywall/wp-plugin-block",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "graphql-codegen",
    "build": "run-s build:*",
    "// この`i18n`コマンドは間接的に`wp-env run cli wp 18n`コマンドを呼び出します。": "",
    "// そのため、`wp-env start`で起動されるcli実行用のコンテナが立ち上がっていない場合、失敗します。": "",
    "// `prepare`で`i18n`コマンドを実行すると高確率で失敗するので注意してください。": "",
    "build:i18n": "run-s i18n",
    "build:js": "wp-scripts build",
    "check": "run-p check:*",
    "check:cycles": "madge --circular --extensions ts,tsx src",
    "check:license": "MODE=CHECK tsx ../../scripts/npm-scripts/pnpm-license-tool.ts",
    "clean": "run-p clean:*",
    "clean:coverage": "rm -rf coverage",
    "clean:js": "rm -rf build/*",
    "coverage": "bash ../../scripts/npm-scripts/coverage-jest.sh --coverageDirectory=coverage/jest",
    "dev": "run-s watch",
    "// wp-envの起動設定(--xdebug=)によってphpunitのテストは問題なく終了するがカバレッジレポートが出力されない、という状況になるため、": "",
    "// カバレッジレポートが出力されているかどうかのチェック処理を`postcoverage:php`に記述している。": "",
    "postcoverage:php": "test -f coverage/phpunit/index.html || exit 1",
    "premy-docker:start": "bash ./.devcontainer/development-internal/update-compose-network.sh",
    "my-docker:start": "bash ./.devcontainer/development-internal/start.sh",
    "export-license": "MODE=EXPORT tsx ../../scripts/npm-scripts/pnpm-license-tool.ts",
    "format": "run-p format:*",
    "format:js": "run-s format:js:*",
    "format:js:eslint": "bash ../../scripts/npm-scripts/format-eslint.sh .",
    "format:js:prettier": "bash ../../scripts/npm-scripts/format-prettier.sh .",
    "i18n": "i18next-cli extract",
    "lint": "run-p lint:*",
    "// lint:css": "wp-scripts lint-style",
    "lint:js": "run-p lint:js:*",
    "lint:js:tsc": "bash ../../scripts/npm-scripts/lint-tsc.sh",
    "lint:js:eslint": "bash ../../scripts/npm-scripts/lint-eslint.sh .",
    "lint:js:prettier": "bash ../../scripts/npm-scripts/lint-prettier.sh .",
    "packages-update": "wp-scripts packages-update",
    "start:docker": "run-p env:start my-docker:start",
    "test": "bash ../../scripts/npm-scripts/test-jest.sh",
    "pretest:storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "update:package": "npx npm-check-updates -u --target minor",
    "prewatch": "run-s prebuild",
    "watch": "run-p watch:*",
    "watch:block": "wp-scripts start",
    "watch:graphql": "graphql-codegen --watch"
  },
  "# note": {
    "// - scripts": "",
    "//   - check:license: ": "",
    "//     - 'GPLv3'や'GPLv3 or later'はGPLv2と互換がないため指定不可": "",
    "//        ⇒ https://www.gnu.org/licenses/gpl-faq.ja.html#gpl-compat-matrix": "",
    "//     - 'Apache-2.0'はGPLv2と互換がないため指定不可": "",
    "//     - 'Apache-2.0 WITH LLVM-exception'は指定可": "",
    "//        ⇒ https://github.com/ccampbell/mousetrap/issues/421": "",
    "// - devDependencies: ": "",
    "//   - @wordpress/scripts": "",
    "//     - v28.0.0 から、WordPress 6.5 以前を対象としたビルドは非推奨となった": "",
    "//     - そのため、WordPress 6.5 以前を対象とする場合は v27 を使う必要がある": "",
    "//       => https://github.com/WordPress/gutenberg/blob/d649865283aff3545f9754a01c92982e37602dc8/packages/scripts/CHANGELOG.md#breaking-changes-2": ""
  },
  "dependencies": {
    "@baywall/lib-frontend": "workspace:*",
    "@baywall/lib-value-object": "workspace:*",
    "@graphql-typed-document-node/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@wordpress/icons": "^17.0.0",
    "assert": "catalog:",
    "async-lock": "catalog:",
    "currency-codes": "catalog:",
    "fast-deep-equal": "^3.1.3",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "jotai": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-codegen/typescript-react-query": "catalog:",
    "@storybook/addon-coverage": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/addon-onboarding": "catalog:",
    "@storybook/addon-webpack5-compiler-swc": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-webpack5": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/assert": "catalog:",
    "@types/async-lock": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/wordpress__block-editor": "^15.0.6",
    "@wordpress/components": "^41.0.0",
    "@wordpress/scripts": "^36.0.0",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "i18next-cli": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "madge": "catalog:",
    "npm-run-all": "catalog:",
    "prettier": "catalog:",
    "process": "catalog:",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "catalog:",
    "swc-loader": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
