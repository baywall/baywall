{
  "name": "baywall",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "You can set up a paywall for blockchain payments.",
  "license": "Split License",
  "files": [
    "build/**",
    "includes/**/*.*",
    "languages/**",
    "public/**",
    "src/**",
    "vendor/**/*.php",
    "*.php",
    "LICENSE",
    "licenses/**",
    "readme.*"
  ],
  "scripts": {
    "build": "run-s build:*",
    "build:i18n": "bash scripts/npm/build-i18n.sh",
    "check": "MODE=CHECK tsx ../../scripts/npm-scripts/composer-license-tools.ts",
    "clean": "rm -rf includes/cache/*.php",
    "coverage": "pnpm test --coverage-html coverage/phpunit",
    "export-license": "MODE=EXPORT tsx ../../scripts/npm-scripts/composer-license-tools.ts",
    "format": "run-s format:*",
    "// phpcsはドキュメントの警告が多いためphpcbfで代用": "",
    "format:php": "tests/vendor/bin/phpcbf --parallel=${PHPCS_PARALLEL:-$(nproc)} . || tests/vendor/bin/phpcbf --parallel=${PHPCS_PARALLEL:-$(nproc)} .",
    "format:eslint": "bash ../../scripts/npm-scripts/format-eslint.sh e2e scripts",
    "format:prettier": "bash ../../scripts/npm-scripts/format-prettier.sh .",
    "lint": "run-p lint:*",
    "lint:php": "tests/vendor/bin/phpcbf --parallel=${PHPCS_PARALLEL:-$(nproc)} .",
    "lint:eslint": "bash ../../scripts/npm-scripts/lint-eslint.sh e2e scripts",
    "lint:prettier": "bash ../../scripts/npm-scripts/lint-prettier.sh .",
    "// ルートにtsconfigがないためe2eのプロジェクトを明示的に指定します": "",
    "lint:tsc": "bash ../../scripts/npm-scripts/lint-tsc.sh -p e2e",
    "// @wordpress/scripts@27.9.0ではサブディレクトリが作成されないためコメントアウト plugin-zip": "wp-scripts plugin-zip --root-folder=baywall && mv baywall.zip baywall.${npm_package_version}.zip",
    "plugin-zip": "bash ./scripts/plugin-zip.sh",
    "// 支払データを初期化し、再度同一ページで購入できるようにします。※ブラウザ側のlocalstorageは手動で削除してください。": "",
    "reset:payment-data": "wp-env run cli wp eval-file wp-content/plugins/${PWD##*/}/.bin/reset-payment-data.php",
    "// E2Eテスト(Playwright)。事前に pnpm build（frontend-admin の public/admin 生成）と wp-env:start:tests が必須": "",
    "e2e": "STORAGE_STATE_PATH=e2e/.auth/admin.json playwright test --config=e2e/playwright.config.ts",
    "// テスト実行環境(DevContainer/GitHub Actions)を判別し、マーカーファイル(.test-environment)を書き込みます": "",
    "pretest": "bash scripts/npm/write-test-environment.sh",
    "// 1つのファイルをテストする場合はテスト対象ファイルのパスを後ろに付与してください => pnpm test tests/classes/path-to-test-file.php": "",
    "test": "pnpm clean && pnpm exec wp-env --config .wp-env.tests.json run --env-cwd=\"wp-content/plugins/${PWD##*/}\" cli tests/vendor/bin/phpunit -- -c phpunit.xml --testdox",
    "update:package": "composer update",
    "// `WP_ENV_MYSQL_PORT`,`WP_ENV_TESTS_MYSQL_PORT`,`WP_ENV_PHPMYADMIN_PORT`,`WP_ENV_TESTS_PHPMYADMIN_PORT`を": "",
    "// 指定すると証明書エラーが発生(原因未調査)": "",
    "wp-env:start": "WP_ENV_PHP_VERSION=${PHP_VERSION} WP_ENV_CORE=WordPress/WordPress#${WP_VERSION} wp-env start --xdebug=develop,coverage,debug",
    "wp-env:start:tests": "WP_ENV_PHP_VERSION=${PHP_VERSION} WP_ENV_CORE=WordPress/WordPress#${WP_VERSION} wp-env --config .wp-env.tests.json start --xdebug=develop,coverage,debug",
    "wp-env:start:all": "pnpm wp-env:start && pnpm wp-env:start:tests",
    "wp-env:reset": "wp-env reset all && pnpm wp-env:start",
    "wp-env:destroy": "wp-env destroy",
    "wp-env:destroy:tests": "wp-env --config .wp-env.tests.json destroy"
  },
  "dependencies": {
    "@baywall/wp-plugin-block": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@wordpress/e2e-test-utils-playwright": "^2.0.0",
    "@wordpress/env": "^11.15.0",
    "ethers": "^6.17.0",
    "wrangler": "^4.134.0"
  }
}
