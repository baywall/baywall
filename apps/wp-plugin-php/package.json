{
  "name": "baywall",
  "version": "1.0.0-alpha.3",
  "private": true,
  "description": "You can set up a paywall for blockchain payments.",
  "license": "Split License",
  "files": [
    "resources/**/*.*",
    "var/cache/.gitkeep",
    "languages/**",
    "public/**",
    "src/**",
    "vendor/**/*.php",
    "*.php",
    "LICENSE",
    "licenses/**",
    "readme.*"
  ],
  "scripts": {
    "build": "run-s build:*",
    "build:assets": "bash scripts/build/copy-frontend-assets.sh",
    "build:i18n": "bash scripts/build/build-i18n.sh",
    "check": "MODE=CHECK tsx ../../scripts/npm-scripts/composer-license-tools.ts",
    "clean": "rm -rf var/cache/*.php public/admin public/view public/block languages/*.mo",
    "coverage": "pnpm test --coverage-html coverage/phpunit",
    "dev": "tsx scripts/dev/watch-frontend-assets.ts",
    "export-license": "run-s export-license:backend export-license:collect",
    "export-license:backend": "MODE=EXPORT tsx ../../scripts/npm-scripts/composer-license-tools.ts",
    "export-license:collect": "bash scripts/build/collect-licenses.sh",
    "format": "run-s format:*",
    "// phpcsはドキュメントの警告が多いためphpcbfで代用": "",
    "format:php": "tests/vendor/bin/phpcbf --parallel=${PHPCS_PARALLEL:-$(nproc)} . || tests/vendor/bin/phpcbf --parallel=${PHPCS_PARALLEL:-$(nproc)} .",
    "format:eslint": "bash ../../scripts/npm-scripts/format-eslint.sh e2e scripts",
    "format:prettier": "bash ../../scripts/npm-scripts/format-prettier.sh .",
    "lint": "run-p lint:*",
    "lint:php": "tests/vendor/bin/phpcbf --parallel=${PHPCS_PARALLEL:-$(nproc)} .",
    "lint:eslint": "bash ../../scripts/npm-scripts/lint-eslint.sh e2e scripts",
    "lint:prettier": "bash ../../scripts/npm-scripts/lint-prettier.sh .",
    "// ルートにtsconfigがないためe2eのプロジェクトを明示的に指定します": "",
    "lint:tsc": "bash ../../scripts/npm-scripts/lint-tsc.sh -p e2e",
    "// @wordpress/scripts@27.9.0ではサブディレクトリが作成されないためコメントアウト plugin-zip": "wp-scripts plugin-zip --root-folder=baywall && mv baywall.zip baywall.${npm_package_version}.zip",
    "plugin-zip": "bash ./scripts/build/plugin-zip.sh",
    "// 支払データを初期化し、再度同一ページで購入できるようにします。※ブラウザ側のlocalstorageは手動で削除してください。": "",
    "reset:payment-data": "wp-env run cli wp eval-file wp-content/plugins/${PWD##*/}/scripts/dev-data/reset-payment-data.php",
    "// 販売履歴画面の表示確認用ダミーデータを投入します。引数は $args[0] = 投入件数（既定 1500）、$args[1] = 乱数シード。reset:payment-data は invoice / transaction / transfer_event を TRUNCATE するため、その後に実行してください。作り直しは pnpm wp-env:reset（再実行すると件数が加算されるため、件数の確認は作り直し後に行ってください）": "",
    "seed:sales-histories": "wp-env run cli wp eval-file wp-content/plugins/${PWD##*/}/scripts/dev-data/seed-sales-histories.php",
    "// E2Eテスト(Playwright)。事前に pnpm build（apps/wp-plugin-php/public/** の生成）と wp-env:start:tests が必須": "",
    "e2e": "STORAGE_STATE_PATH=e2e/.auth/admin.json playwright test --config=e2e/playwright.config.ts",
    "// テスト実行環境(DevContainer/GitHub Actions)を判別し、マーカーファイル(.test-environment)を書き込みます": "",
    "pretest": "bash scripts/ci/write-test-environment.sh",
    "// 1つのファイルをテストする場合はテスト対象ファイルのパスを後ろに付与してください => pnpm test tests/classes/path-to-test-file.php": "",
    "test": "pnpm clean && pnpm exec wp-env --config .wp-env.tests.json run --env-cwd=\"wp-content/plugins/${PWD##*/}\" cli tests/vendor/bin/phpunit -- -c phpunit.xml --testdox",
    "// wp-envを使わずホスト側のPHPUnitを直接実行します（MySQL実機テスト用）。DB接続はWP_TESTS_DIR/wp-tests-config.phpから読み取ります": "",
    "test:mysql": "bash scripts/ci/test-mysql.sh",
    "update:package": "composer update",
    "// `WP_ENV_MYSQL_PORT`,`WP_ENV_TESTS_MYSQL_PORT`,`WP_ENV_PHPMYADMIN_PORT`,`WP_ENV_TESTS_PHPMYADMIN_PORT`を": "",
    "// 指定すると証明書エラーが発生(原因未調査)": "",
    "wp-env:start": "bash scripts/wp-env/start-wp-env.sh .wp-env.json",
    "wp-env:start:tests": "bash scripts/wp-env/start-wp-env.sh .wp-env.tests.json",
    "wp-env:start:all": "pnpm wp-env:start && pnpm wp-env:start:tests",
    "wp-env:reset": "wp-env reset all && pnpm wp-env:start",
    "wp-env:destroy": "wp-env destroy",
    "wp-env:destroy:tests": "wp-env --config .wp-env.tests.json destroy"
  },
  "dependencies": {
    "@baywall/wp-plugin-block": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@wordpress/e2e-test-utils-playwright": "^3.0.0",
    "@wordpress/env": "^11.17.0",
    "chokidar": "^5.0.0",
    "eslint": "catalog:",
    "ethers": "catalog:",
    "npm-run-all": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
